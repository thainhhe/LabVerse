<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Các quyền cần thiết cho ứng dụng -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Đối với Android phiên bản cũ hơn, các quyền này vẫn cần thiết -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />


    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LabVerse"
        tools:targetApi="31">

        <!-- 1. Splash Activity: Màn hình khởi động của ứng dụng -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.LabVerse.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Login Activity: Màn hình đăng nhập -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.LabVerse.NoActionBar" />

        <!-- 3. Main Activity: Màn hình chính sau khi đăng nhập -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.LabVerse.NoActionBar" />

        <!-- Các màn hình phụ khác -->
        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.LabVerse.NoActionBar" />

        <activity
            android:name=".activities.ImportPaperActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".activities.PaperDetailActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".activities.PdfReaderActivity"
            android:exported="false"
            android:parentActivityName=".activities.PaperDetailActivity" />

        <activity
            android:name=".activities.CollectionDetailActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".activities.CreateCollectionActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".activities.EditProfileActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".activities.ManualEntryActivity"
            android:exported="false"
            android:parentActivityName=".activities.ImportPaperActivity" />

        <activity
            android:name=".activities.PdfProcessingActivity"
            android:exported="false"
            android:parentActivityName=".activities.ImportPaperActivity" />

        <activity
            android:name=".activities.BibtexProcessingActivity"
            android:exported="false"
            android:parentActivityName=".activities.ImportPaperActivity" />

        <activity
            android:name=".activities.SearchActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity android:name=".activities.SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.LabVerse.NoActionBar"/>


        <!-- File Provider để chia sẻ file một cách an toàn -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>